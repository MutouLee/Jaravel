# 构建产物
target/
out/
negout/
build/
*.class
*.jar
*.war

# ★ 例外:ViteTest 的 manifest 夹具。
#
# 它的路径里有一个 build/(那正是 @vite 的默认产物目录,见 ADR-020),
# 于是上面那条 build/ 把它一起挡掉了 —— 而本地有这个文件、CI 没有,
# 症状是「本地全绿、CI 上 ViteTest 全红」。实打实踩到过一次。
#
# 目录本身要先反排除:git 不会进入一个被忽略的目录,
# 只写文件级的例外不生效。
!jaravel-view/src/test/resources/public/build/

# 本地命令通道与冷启动缓存(.jaravel/):
# dev.sock 是进程地址,classpath / main-class 是这台机器上的绝对路径 ——
# 三样都不该跟着仓库走
.jaravel/

# 本地 SQLite 数据库
*.db

# 验证工程的中间产物
verification/**/out/
verification/**/out-seeded/
verification/**/driver*.log
verification/**/negout/
verification/**/build/
verification/**/target/
verification/**/cp.txt
verification/**/negative/*.log
verification/**/scale/java/
verification/v3-jblade-jte/target/jte-classes/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db
desktop.ini

# 环境与密钥
.env
.env.local
*.pem
*.key

# 日志
*.log
logs/

# 示例应用的运行时产物
examples/*/storage/*
!examples/*/storage/.gitkeep
examples/*/target/

# 验收脚本的输出(每次运行重新生成)
check-result.txt
verify-result.txt
diag-result.txt
benchmark/laravel-parity/parity-result.txt

# 一次性诊断脚本
diag.py
check.py

# v0.2 新增的输出
verify-blog-result.txt
benchmark/jpa-comparison/benchmark-result.txt
examples/*/cp.txt
benchmark/jpa-comparison/target/

# 示例应用的运行时产物
examples/*/storage/*
!examples/*/storage/.gitkeep
