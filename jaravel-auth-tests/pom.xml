<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jaravel-auth-tests</artifactId>
  <name>Jaravel :: 认证集成测试</name>
  <description>
    对真 SQLite + 真会话作用域跑认证全链路。
    独立成模块的原因与 jaravel-eloquent-tests 相同:
    被测模型需要 @Model 的 APT 生成基类,而 APT 在 src/main/java 上才稳定生效。
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-eloquent</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-eloquent-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>

    <!--
      模型的 created_at 是 Instant;不带这个模块的 ObjectMapper 直接抛异常,
      而 AuthSecurityTest ⑫ 测的是「password 不出现在 JSON 里」——
      缺序列化器会让它因为时间字段失败,看起来像密码泄露测试写错了。
      生产环境里这个模块由 spring-boot-starter-web 带入。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs><arg>-parameters</arg></compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>io.jaravel</groupId>
              <artifactId>jaravel-eloquent-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
