<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 刻意不继承 jaravel-parent:BOM 继承 parent 会形成 import 循环,
       且 BOM 不该携带构建配置。Spring 自己的 BOM 同样是独立的。 -->
  <groupId>net.dobeen.jaravel</groupId>
  <artifactId>jaravel-bom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Jaravel :: BOM</name>
  <description>统一版本管理。用户侧 import 这一个即可</description>
  <url>https://github.com/MutouLee/Jaravel</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>mutoulee</id>
      <name>Dobeen</name>
      <email>mutou.lee@qq.com</email>
      <url>https://github.com/MutouLee</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/MutouLee/Jaravel.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/MutouLee/Jaravel.git</developerConnection>
    <url>https://github.com/MutouLee/Jaravel</url>
  </scm>

  <properties>
    <jaravel.version>1.0.0</jaravel.version>
    <!-- 浏览器测试的可选依赖;与 parent pom 的 playwright.version 保持一致 -->
    <playwright.version>1.49.0</playwright.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-support</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-core</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-http</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-routing</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-view</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-database</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-eloquent</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-eloquent-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-migration</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-validation</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-queue</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-dashboard</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-events</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-events-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-scheduler</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-mail</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-console</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-cli</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-api</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-api-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-http-client</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-notifications</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-broadcasting</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-storage</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-cache</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-session</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-auth</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-permissions</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-devtools</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-security-bridge</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-testing</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-spring-boot-starter</artifactId><version>${jaravel.version}</version></dependency>

      <!--
        v0.9 安全覆盖。Spring Boot 3.5.16 的 BOM 早于下列补丁发布;
        应用侧把 jaravel-bom 放在 spring-boot-dependencies **之前** import,
        这些条目就会先赢(同名依赖第一次声明生效)。
        不在这一层的组件(如 Spring Framework 6.2.19 的两条 critical)
        没有 6.2.x 修复版本,见 SECURITY-AUDIT.md §5。
      -->
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId><version>10.1.59</version></dependency>
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-el</artifactId><version>10.1.59</version></dependency>
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-websocket</artifactId><version>10.1.59</version></dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.1.137.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>com.rabbitmq</groupId><artifactId>amqp-client</artifactId><version>5.38.0</version></dependency>
      <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.8.0-jre</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.22.0</version></dependency>
      <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.26.1</version></dependency>

      <!--
        BrowserTest 的可选依赖:jaravel-testing 里它是 optional,所以要用
        浏览器测试的应用需要在自己的 test 作用域显式声明它。版本在这里管,
        用户 pom 不需要知道具体版本。
      -->
      <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>${playwright.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    BOM 不继承 jaravel-parent,于是也拿不到父 POM 的 `release` profile。
    发布时必须在这里重复一遍最小集合:GPG 签名 + Central Portal 上传插件。
    (POM-only 构件不需要 sources/javadoc jar。)
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
