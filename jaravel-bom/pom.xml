<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 刻意不继承 jaravel-parent:BOM 继承 parent 会形成 import 循环,
       且 BOM 不该携带构建配置。Spring 自己的 BOM 同样是独立的。 -->
  <groupId>io.jaravel</groupId>
  <artifactId>jaravel-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Jaravel :: BOM</name>
  <description>统一版本管理。用户侧 import 这一个即可</description>

  <properties>
    <jaravel.version>0.1.0-SNAPSHOT</jaravel.version>
    <!-- 浏览器测试的可选依赖;与 parent pom 的 playwright.version 保持一致 -->
    <playwright.version>1.49.0</playwright.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-support</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-core</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-http</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-routing</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-view</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-database</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-eloquent</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-eloquent-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-migration</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-validation</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-queue</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-dashboard</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-events</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-events-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-scheduler</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-mail</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-console</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-cli</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-api</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-api-processor</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-http-client</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-notifications</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-broadcasting</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-storage</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-cache</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-session</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-auth</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-permissions</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-devtools</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-security-bridge</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-testing</artifactId><version>${jaravel.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-spring-boot-starter</artifactId><version>${jaravel.version}</version></dependency>

      <!--
        BrowserTest 的可选依赖:jaravel-testing 里它是 optional,所以要用
        浏览器测试的应用需要在自己的 test 作用域显式声明它。版本在这里管,
        用户 pom 不需要知道具体版本。
      -->
      <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>${playwright.version}</version></dependency>
    </dependencies>
  </dependencyManagement>
</project>
