<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jaravel-broadcasting</artifactId>
  <name>Jaravel :: 广播</name>
  <description>事件广播(ShouldBroadcast)、频道注册与鉴权、通知 broadcast 渠道</description>

  <!--
    零 Spring(docs/19 §6.1)。WebSocket 传输在 jaravel-spring-boot-starter
    的适配层里 —— 这里只有频道注册表、驱动契约与 null / log 驱动。
  -->
  <dependencies>
    <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-core</artifactId></dependency>
    <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-support</artifactId></dependency>
    <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-events</artifactId></dependency>
    <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-notifications</artifactId></dependency>

    <!--
      payload 序列化。与 jaravel-queue / jaravel-session / jaravel-cache
      同一套 Jackson 版本管理(spring-boot-dependencies 的 BOM)。
    -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
  </dependencies>

</project>
