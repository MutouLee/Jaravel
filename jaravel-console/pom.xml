<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jaravel-console</artifactId>
  <name>Jaravel :: Artisan 控制台</name>
  <description>命令内核、输出/交互/进度条 API、Artisan 门面、make:* 代码生成与 stub 机制</description>

  <dependencies>
    <!-- Str 的命名推断(studly / snake / plural)是 make:* 的地基 -->
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-support</artifactId>
    </dependency>

    <!--
      openapi:diff 要读两份 OpenAPI JSON。

      ★ 只在这个模块里加,**不放进 jaravel-support**:support 是零依赖的
      工具层,而一条只服务 openapi:diff 的 JSON 解析器不该改变那一层。
      手写一个 JSON 解析器更不值得 —— 它要处理转义、数字、嵌套,
      而每一个边界条件都是一个会静默读错契约的机会。

      它会进 CLI 的 classpath,但只在 openapi:diff 真正跑起来时才加载,
      make:* 那条 100ms 的路径不受影响。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!--
      注意这里**没有** jaravel-view 的依赖。

      stub 是模板,照 docs/13 §4.1 本该用 jblade 渲染(「自举」)。
      但 make:* 是**离线命令**:docs/13 的头号设计目标是它在 100ms 内跑完,
      而将来它跑在 GraalVM native 的 jaravel-cli 里 —— 那里既没有
      javac 也没有 jte 的运行时编译,而 jblade 的预编译要等 v0.9。

      所以 stub 用一个只认 {{ 变量 }} 的渲染器(Stub 类),
      它刚好够用:docs/13 自己就是用「每个变体一个 stub 文件」
      (controller.resource / controller.api / migration.create)
      来避免模板里的条件分支的。
      这条取舍与 jaravel-mail 不依赖 jaravel-view 是同一类决定。
    -->
  </dependencies>
  <build>
    <plugins>
      <!--
        把 Implementation-Version 写进 manifest。

        ★ 为什么是**这个**模块需要它:wrapper:install 要把一个版本号钉进
        生成的 jaravelw 脚本里,而它读的是自己所在 jar 的 manifest
        (getClass().getPackage().getImplementationVersion())。
        这个命令住在 jaravel-console,所以是这里的 manifest 说话 ——
        此前只有 jaravel-cli 配了这几行,于是从 jar 里跑也读不到版本号
        (端到端跑 ./jaravelw wrapper:install 时当场撞上)。

        框架的所有模块同版本发布(有 BOM),所以这个号就是要钉的那个号。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
