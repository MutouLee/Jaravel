@params(String csrf, String email, String error, String status)
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>忘记密码</title>
  <style>
    body { font: 16px/1.6 system-ui, sans-serif; max-width: 360px; margin: 80px auto; padding: 0 24px; }
    label { display: block; margin: 14px 0 4px; }
    input { width: 100%; padding: 8px; box-sizing: border-box; }
    button { margin-top: 18px; width: 100%; padding: 10px; }
    .error { color: #b91c1c; background: #fef2f2; padding: 8px 12px; border-radius: 6px; }
    .ok { color: #166534; background: #f0fdf4; padding: 8px 12px; border-radius: 6px; }
    a { color: #2563eb; }
  </style>
</head>
<body>
  <h1>忘记密码</h1>

  @if (status != null && !status.isBlank())
  <p class="ok">\{{ status }}</p>
  @endif
  @if (error != null && !error.isBlank())
  <p class="error">\{{ error }}</p>
  @endif

  <form method="post" action="/forgot-password">
    <input type="hidden" name="_token" value="\{{ csrf }}">
    <label for="email">邮箱</label>
    <input id="email" type="email" name="email" value="\{{ email }}" required autofocus>
    <button type="submit">发送重置链接</button>
  </form>

  <p><a href="/login">返回登录</a></p>
</body>
</html>
