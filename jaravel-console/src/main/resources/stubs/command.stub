package {{ pkg }};

import org.springframework.stereotype.Component;

import io.jaravel.console.Argument;
import io.jaravel.console.Command;
import io.jaravel.console.ConsoleCommand;
import io.jaravel.console.Option;

/**
 * {@code @Component} 让容器建它,于是依赖可以从构造器注入。
 *
 * <p>作用域不用管:注册表每跑一次都**新造一个实例**,
 * 所以上一条命令解析出来的选项不会漏到下一条。
 */
@Component
@Command(name = "{{ commandName }}", description = "TODO 这条命令做什么")
public class {{ class }} extends ConsoleCommand {

    @Argument(description = "TODO 位置参数", required = false)
    String target;

    @Option(names = {"-f", "--force"}, description = "TODO")
    boolean force;

    @Override
    public int handle() {
        info("TODO");

        // 输出:line / info / comment / warn / success / error
        // 表格:table(List.of("列"), rows)
        // 进度:withProgressBar(items, item -> ...)
        // 交互:confirm / ask / choice / secret
        //   ⚠ 不可交互时(管道、CI)交互方法直接返回默认值

        return 0;   // 退出码。非 0 = 失败
    }
}
