<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jaravel-devtools</artifactId>
  <name>Jaravel :: 开发工具</name>
  <description>
    热重载:文件监听、变更分类、L1 资源重载、L3 重启协调(请求挂起 + 重放)。

    零 Spring 依赖(ADR-001)—— 与 Spring / Servlet 的接线在
    jaravel-spring-boot-starter 的 io.jaravel.spring.dev 下。
  </description>

  <dependencies>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- L2 的测试要真的挂载 agent,而 JDK 9 之后
               自挂载默认禁止。
               不加这个参数的话 HotSwapperTest 里那组
               真正验证热替换的测试会全部跳过 ——
               而一组永远跳过的测试等于没有测试 -->
          <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8
                   -Djdk.attach.allowAttachSelf=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>