<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.dobeen.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>jaravel-queue</artifactId>
  <name>Jaravel :: 队列</name>
  <description>
    Job 契约、JSON 信封、投递 API 与 sync / null / database 驱动。
    Worker 在 jaravel-queue 的 worker 包下。
  </description>

  <dependencies>
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-core</artifactId>
    </dependency>
    <!-- 框架事件(JobQueued / Processing / Processed / Failed / RetryRequested) -->
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-events</artifactId>
    </dependency>
    <!--
      database 驱动需要它。不设 optional:队列的零依赖默认驱动就是
      database(config/queue.yml 的 default),把它做成可选会让
      「开箱即用」变成「先读文档加依赖」。
    -->
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-database</artifactId>
    </dependency>

    <!-- 任务中间件的锁与限流器;唯一性任务也用它 -->
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-cache</artifactId>
    </dependency>

    <!-- redis 队列驱动;不用它的人不必拉 Lettuce。
         连接生命周期复用 jaravel-cache 的 RedisStore(惰性连接/URI/关闭) -->
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- rabbitmq 队列驱动;不用它的人不必拉 AMQP 客户端 -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- sqs 队列驱动;不用它的人不必拉 AWS SDK -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${aws-sdk.version}</version>
      <optional>true</optional>
    </dependency>
    <!--
      dynamodb 失败归档(queue.failed.driver: dynamodb)。

      它存在的场景只有一个:AWS 上**没有关系库**的部署
      (Lambda/Fargate + SQS,没有 RDS 也没有 ElastiCache)。
      那种应用否则只能退到 log 驱动 —— 失败任务只剩日志里一行,
      queue:retry 用不了,也就是说任务丢了之后没有补救手段。
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${aws-sdk.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- SDK 需要一个同步 HTTP 客户端实现;URLConnection 最轻 -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>${aws-sdk.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-parameter-names</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- 测试里断言「任务作用域里没有请求作用域」需要它 -->
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-http</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
