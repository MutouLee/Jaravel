<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jaravel-session</artifactId>
  <name>Jaravel :: 会话</name>
  <description>
    独立于 HttpSession 的会话实现:cookie / cache / database 驱动、
    flash 语义、CSRF 令牌、会话固定防护。
  </description>

  <dependencies>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-http</artifactId>
    </dependency>
    <!-- cache 驱动的会话存储(redis / file / database 都经由它) -->
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-cache</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- database 驱动需要「登出其它设备」所需的 user_id / ip / ua 列 -->
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-database</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
