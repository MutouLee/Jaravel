<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jaravel-spring-boot-starter</artifactId>
  <name>Jaravel :: Spring Boot Starter</name>
  <description>自动装配与 Spring 适配 —— ★ 唯一允许 import org.springframework 的模块(ADR-001)</description>

  <dependencies>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-routing</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-view</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-database</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-eloquent</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-migration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-devtools</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-queue</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-events</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-session</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jaravel</groupId>
      <artifactId>jaravel-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      L3 的双类加载器由 devtools 提供 —— 重新实现一遍它是性价比极低的
      自研(docs/15 明确说「复用其思路」)。Jaravel 加的是它没有的两件事:
      请求挂起 与 按需重启。optional:生产部署不该带它。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
