<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.dobeen.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>jaravel-testing</artifactId>
  <name>Jaravel :: 测试支持</name>
  <description>
    FeatureTest / BrowserTest / TestResponse / 数据库断言 / 每测试自动回滚。

    不发明测试框架 —— 底层仍是 JUnit 5,本模块只提供基类与断言。
  </description>

  <dependencies>
    <!--
      compile 作用域而不是 test:使用者在**他们的** test 作用域里引入本模块,
      那时本模块自身的依赖必须是 compile 才传递得过去。
    -->
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>

    <!--
      浏览器测试(docs/14 §6.1)。optional:绝大多数测试不需要真实浏览器,
      而 Playwright 会拖入 driver + 浏览器二进制。要用 BrowserTest 的
      应用在自己的 test 作用域里显式引入它。
    -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <optional>true</optional>
    </dependency>

    <!--
      Testcontainers(docs/14 §2.2)。optional:不用 @UseDatabase 的应用
      不该拖入 Docker 客户端与数据库容器模块。用到的应用显式声明
      对应模块(以及 JDBC 驱动)的 test 作用域依赖。
      版本由 Spring Boot BOM 管理(3.5.16 的 testcontainers.version)。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>${testcontainers.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mariadb</artifactId>
      <version>${testcontainers.version}</version>
      <optional>true</optional>
    </dependency>

    <!--
      并行测试的服务端库契约测试(test scope,不传递):
      默认跳过,只有设置 JARAVEL_TEST_PG_URL / JARAVEL_TEST_MYSQL_URL /
      JARAVEL_TEST_MARIADB_URL 时才真的建库。把驱动放在测试里,
      是为了让那些契约测试在设置环境变量后**能跑**,而不是在
      DriverManager 里找不到驱动。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
