# 并行测试的每进程数据源(docs/14 §6.3、ADR-017)。
# 只在 -Djaravel.test.parallel=true / JARAVEL_TEST_PARALLEL=1 时生效 ——
# 本模块通常只在 test 作用域,但 jaravel-archunit-rules 等模块会把它带进
# 编译作用域,所以开关必须显式。
org.springframework.boot.env.EnvironmentPostProcessor=\
net.dobeen.jaravel.testing.ParallelTestDatabase

# @UseDatabase:Testcontainers 自动注入(docs/14 §2.2)。
# 只有标了注解的测试类才会加载 Testcontainers(它在本模块里是 optional)。
org.springframework.test.context.ContextCustomizerFactory=\
net.dobeen.jaravel.testing.testcontainers.UseDatabaseContextCustomizerFactory
