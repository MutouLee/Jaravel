<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.dobeen.jaravel</groupId>
    <artifactId>jaravel-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>jaravel-view</artifactId>
  <name>Jaravel :: View</name>
  <description>jblade 模板引擎:Blade 前端 + jte 后端(ADR-011)</description>

  <dependencies>
    <dependency>
      <groupId>net.dobeen.jaravel</groupId>
      <artifactId>jaravel-core</artifactId>
    </dependency>
    <dependency>
      <groupId>gg.jte</groupId>
      <artifactId>jte</artifactId>
      <version>${jte.version}</version>
    </dependency>
    <!--
      vite 的 manifest.json(Vite.java)。

      显式声明而不是靠 jaravel-core 传递进来:用一个传递依赖的包
      是「它哪天不传了就编译不过」的那类隐患。
      为一个机器生成的 manifest 再引一个 JSON 库不划算 ——
      YAML 是 JSON 的超集,理由写在 Vite.parse 上。
    -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
  </dependencies>
</project>
