  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs>
              <!-- 路由参数绑定的反射回落路径需要参数名 -->
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- @{...} 是**后期求值**:jacoco 在 initialize 阶段写进这个属性,
                 而 ${...} 会在那之前就被定下来(于是永远是空的) -->
            <argLine>@{jacocoArgLine} -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.12</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        覆盖率(v0.5 验收 #4)。

        每个模块各自记一份 target/jacoco.exec;汇总在 jaravel-coverage 模块
        (那里有 report-aggregate)。
        **必须汇总而不是看单模块的数**:这个仓库刻意把集成测试放在独立模块里
        (jaravel-auth-tests / eloquent-tests / events-tests),而示例应用
        本身也是测试。只看单模块的话 jaravel-auth 会显示接近 0% ——
        它的测试在隔壁。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!-- 不用默认的 argLine:父 pom 的 surefire 写死了那个参数,
                   换一个名字再由 @{jacocoArgLine} 拼进去 -->
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      依赖收敛检查。**不默认启用** —— dependencyConvergence 对历史上的
      版本漂移是硬失败,默认构建不该因为它红。

      mvn -Psecurity -DskipTests verify
    -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>enforce-security</id>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <dependencyConvergence/>
                    <banDuplicatePomDependencyVersions/>
                    <requireJavaVersion>
                      <version>[21,)</version>
                    </requireJavaVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      发布 profile。只在真正发布时启用:
        mvn -Prelease deploy
      需要 ~/.m2/settings.xml 里配置 `central` server、GPG 密钥与
      Central Portal 命名空间;见 RELEASE.md。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
