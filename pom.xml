    <!--
      ★ 示例也进 reactor。

      它们此前不在构建里,后果是实测过的:examples/blog 与 examples/todo
      按提交的样子**起不来** —— auth 模块(v0.3)之后 app.key 变成
      启动即校验的饿加载 bean,而那两个示例写在那之前、配置里没有那一行。
      没有任何一条测试会发现,因为没有任何东西跑它们。

      而 auth 与 queue 各自带着真实的验收测试(91 + N 条)却同样不被跑 ——
      也就是说这里本来就有一批已经写好的测试在白白腐坏。

      代价:构建变长(四个示例各要起一次真的 Spring 上下文)。
      值:reactor 里解析的是**当前这棵树**的 artifact,
      而不是本地仓库里上一次 install 的那份 —— 后者会让烟雾测试
      在框架已经坏掉时照样通过,那比没有测试更糟。
    -->
    <module>examples/todo</module>
    <module>examples/blog</module>
    <module>examples/auth</module>
    <module>examples/queue</module>
    <module>examples/api-only</module>
    <module>examples/multi-tenant</module>

    <!-- 覆盖率汇总 —— 必须在最后:它要读上面每个模块的 jacoco.exec -->
    <module>jaravel-coverage</module>
  </modules>

  <properties>
    <!--
      ★ 这个空属性是为了 jacoco,而它堵的是一个经典陷阱。

      jacoco 的 prepare-agent 靠**设置 argLine 属性**把 agent 注进 surefire。
      而下面 surefire 的 <argLine> 是写死的 —— 写死会把 agent 顶掉,
      症状是「覆盖率报告出来了,但所有模块都是 0%」,
      而那个 0 看起来像「测试没跑」或者「jacoco 装错了」。
      两者都不是:测试跑了,只是没人在记。
      (这是接覆盖率工具时最常见的一次返工,所以记在这里。)
    -->
    <jacocoArgLine></jacocoArgLine>
    <!-- ADR-007:基线 Java 21 -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- v0.9 安全升级:3.4.1 → 3.5.16。后者带 Spring 6.2.19 /
         Security 6.5.11 / Tomcat 10.1.55 / Jackson 2.21.4。 -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- AWS SDK v2(SQS 驱动)。Spring Boot BOM 不管理 AWS SDK,显式钉版本 -->
    <aws-sdk.version>2.25.60</aws-sdk.version>
    <!-- Playwright for Java(浏览器测试);不是 Spring BOM 管理项 -->
    <playwright.version>1.49.0</playwright.version>
    <!--
      Testcontainers。Spring Boot 3.5.16 的 BOM 已管理 1.21.4;
      显式钉住是为了不随 BOM 回退(1.20.x 连不上 Docker Engine 29)。
    -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- ADR-011:jblade 以 jte 为后端 -->
    <jte.version>3.1.16</jte.version>
    <junit.version>5.11.4</junit.version>
    <!-- 3.27.7 修掉 3.27.0 及之前的一项高危(GHSA-rqfh-9r24-8c9r) -->
    <assertj.version>3.27.7</assertj.version>
    <archunit.version>1.3.0</archunit.version>
    <sqlite.version>3.47.1.0</sqlite.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Testcontainers 的传递模块(jdbc / database-commons / testcontainers)
        显式钉住整组,避免随 BOM 回退到连不上 Docker Engine 29 的旧版本。
        本 POM 自己的管理条目优先于 import。
      -->
      <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>jdbc</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>database-commons</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>mysql</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><version>${testcontainers.version}</version></dependency>
      <dependency><groupId>org.testcontainers</groupId><artifactId>mariadb</artifactId><version>${testcontainers.version}</version></dependency>

      <!--
        v0.9 安全覆盖。Spring Boot 3.5.16 的 BOM 早于下列补丁发布,
        而这些组件的修复都在同一 patch / minor 线上。
      -->
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId><version>10.1.59</version></dependency>
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-el</artifactId><version>10.1.59</version></dependency>
      <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-websocket</artifactId><version>10.1.59</version></dependency>

      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.1.137.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency><groupId>com.rabbitmq</groupId><artifactId>amqp-client</artifactId><version>5.38.0</version></dependency>
      <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.8.0-jre</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.22.0</version></dependency>
      <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.26.1</version></dependency>

      <dependency>
