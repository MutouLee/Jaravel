<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.jaravel</groupId>
  <artifactId>jaravel-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Jaravel</name>
  <description>Laravel 级开发体验,构建在 Spring Boot 之上的 Java 应用框架</description>
  <url>https://github.com/MutouLee/Jaravel</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>jaravel-bom</module>
    <module>jaravel-support</module>
    <module>jaravel-core</module>
    <module>jaravel-http</module>
    <module>jaravel-routing</module>
    <module>jaravel-view</module>
    <module>jaravel-database</module>
    <module>jaravel-eloquent</module>
    <module>jaravel-eloquent-processor</module>
    <module>jaravel-migration</module>
    <module>jaravel-validation</module>
    <module>jaravel-queue</module>
    <module>jaravel-events</module>
    <module>jaravel-events-processor</module>
    <module>jaravel-events-tests</module>
    <module>jaravel-scheduler</module>
    <module>jaravel-mail</module>
    <module>jaravel-console</module>
    <module>jaravel-cli</module>
    <module>jaravel-api</module>
    <module>jaravel-api-processor</module>
    <module>jaravel-http-client</module>
    <module>jaravel-notifications</module>
    <module>jaravel-storage</module>
    <module>jaravel-cache</module>
    <module>jaravel-session</module>
    <module>jaravel-auth</module>
    <module>jaravel-auth-tests</module>
    <module>jaravel-eloquent-tests</module>
    <module>jaravel-devtools</module>
    <module>jaravel-testing</module>
    <module>jaravel-security-bridge</module>
    <module>jaravel-spring-boot-starter</module>
    <module>jaravel-archunit-rules</module>

    <!--
      ★ 示例也进 reactor。

      它们此前不在构建里,后果是实测过的:examples/blog 与 examples/todo
      按提交的样子**起不来** —— auth 模块(v0.3)之后 app.key 变成
      启动即校验的饿加载 bean,而那两个示例写在那之前、配置里没有那一行。
      没有任何一条测试会发现,因为没有任何东西跑它们。

      而 auth 与 queue 各自带着真实的验收测试(91 + N 条)却同样不被跑 ——
      也就是说这里本来就有一批已经写好的测试在白白腐坏。

      代价:构建变长(四个示例各要起一次真的 Spring 上下文)。
      值:reactor 里解析的是**当前这棵树**的 artifact,
      而不是本地仓库里上一次 install 的那份 —— 后者会让烟雾测试
      在框架已经坏掉时照样通过,那比没有测试更糟。
    -->
    <module>examples/todo</module>
    <module>examples/blog</module>
    <module>examples/auth</module>
    <module>examples/queue</module>

    <!-- 覆盖率汇总 —— 必须在最后:它要读上面每个模块的 jacoco.exec -->
    <module>jaravel-coverage</module>
  </modules>

  <properties>
    <!--
      ★ 这个空属性是为了 jacoco,而它堵的是一个经典陷阱。

      jacoco 的 prepare-agent 靠**设置 argLine 属性**把 agent 注进 surefire。
      而下面 surefire 的 <argLine> 是写死的 —— 写死会把 agent 顶掉,
      症状是「覆盖率报告出来了,但所有模块都是 0%」,
      而那个 0 看起来像「测试没跑」或者「jacoco 装错了」。
      两者都不是:测试跑了,只是没人在记。
      (这是接覆盖率工具时最常见的一次返工,所以记在这里。)
    -->
    <jacocoArgLine></jacocoArgLine>
    <!-- ADR-007:基线 Java 21 -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.4.1</spring-boot.version>
    <!-- ADR-011:jblade 以 jte 为后端 -->
    <jte.version>3.1.12</jte.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.0</assertj.version>
    <archunit.version>1.3.0</archunit.version>
    <sqlite.version>3.47.1.0</sqlite.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 内部模块版本。不 import jaravel-bom —— 那会与 parent 形成循环。
           jaravel-bom 是给**外部用户**的,独立不继承 parent。 -->
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-support</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-http</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-routing</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-view</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-database</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-eloquent</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-eloquent-processor</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-migration</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-validation</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-queue</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-events</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-events-processor</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-scheduler</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-mail</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-console</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-cli</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-http-client</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-notifications</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-storage</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-cache</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-session</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-auth</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-devtools</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-testing</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-security-bridge</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.jaravel</groupId><artifactId>jaravel-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 全模块共享的测试依赖 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs>
              <!-- 路由参数绑定的反射回落路径需要参数名 -->
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- @{...} 是**后期求值**:jacoco 在 initialize 阶段写进这个属性,
                 而 ${...} 会在那之前就被定下来(于是永远是空的) -->
            <argLine>@{jacocoArgLine} -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.12</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        覆盖率(v0.5 验收 #4)。

        每个模块各自记一份 target/jacoco.exec;汇总在 jaravel-coverage 模块
        (那里有 report-aggregate)。
        **必须汇总而不是看单模块的数**:这个仓库刻意把集成测试放在独立模块里
        (jaravel-auth-tests / eloquent-tests / events-tests),而示例应用
        本身也是测试。只看单模块的话 jaravel-auth 会显示接近 0% ——
        它的测试在隔壁。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!-- 不用默认的 argLine:父 pom 的 surefire 写死了那个参数,
                   换一个名字再由 @{jacocoArgLine} 拼进去 -->
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
