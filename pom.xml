      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-scheduler</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-mail</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-console</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-cli</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-http-client</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-notifications</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-broadcasting</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-storage</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-cache</artifactId><version>${project.version}</version></dependency>
