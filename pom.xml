      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-support</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-http</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-routing</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-view</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-database</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-eloquent</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-eloquent-processor</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-migration</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-validation</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-queue</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-dashboard</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>net.dobeen.jaravel</groupId><artifactId>jaravel-events</artifactId><version>${project.version}</version></dependency>
